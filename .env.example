# --- Supabase -------------------------------------------------------------
# Both values are designed to be public: the anon key ships in the browser
# bundle, and every access rule lives in supabase/migrations/0002_rls_and_views.sql
# rather than in the key. Do not add the service-role key here — it bypasses RLS
# and belongs only in the edge function's server environment.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- AI --------------------------------------------------------------------
# NOT prefixed with VITE_ on purpose. A VITE_ variable is inlined into the
# client bundle at build time and would be readable by every visitor.
# Set this in your host's server environment for the /api/ask function:
#   vercel env add DEEPSEEK_API_KEY production
DEEPSEEK_API_KEY=sk-your-key-here

# --- Weather ---------------------------------------------------------------
# Open-Meteo needs no key and no signup. Left as a constant only so the base
# URL can be changed or proxied if api.open-meteo.com is ever unreachable from
# the target region.
VITE_OPEN_METEO_BASE=https://api.open-meteo.com/v1/forecast